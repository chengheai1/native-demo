{
  "expo": {
    "name": "序 XU",
    "slug": "native-demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/xu-icon.png",
    "scheme": "nativedemo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.xu.todo",
      "supportsTablet": false
    },
    "android": {
      "package": "com.xu.todo",
      "adaptiveIcon": {
        "backgroundColor": "#1C1A17",
        "foregroundImage": "./assets/images/xu-adaptive-foreground.png",
        "backgroundImage": "./assets/images/xu-adaptive-background.png",
        "monochromeImage": "./assets/images/xu-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/xu-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F1E7",
          "image": "./assets/images/xu-splash.png",
          "imageWidth": 108,
          "dark": {
            "backgroundColor": "#151412",
            "image": "./assets/images/xu-splash.png",
            "imageWidth": 108
          }
        }
      ],
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3460173d-e6e6-4fd7-8e08-cfd7a0175113"
      }
    },
    "owner": "frank.cheng"
  }
}
