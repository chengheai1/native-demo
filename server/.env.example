# Local development
APP_ENV=development
DATABASE_PATH=./data/app.db

# Publicly reachable origin of this API (used to build the Google redirect URI).
# For the iOS simulator / local device demo: http://localhost:8000
# For a real device, use your computer's LAN IP or an HTTPS tunnel.
PUBLIC_BASE_URL=http://localhost:8000

# Optional web fallback origin (Expo web) and CORS allowlist.
FRONTEND_ORIGIN=http://localhost:8081

# Google Cloud Console -> OAuth 2.0 Client ID (Web application)
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Custom deep link registered by app.json ("scheme": "nativedemo").
NATIVE_REDIRECT_URIS=nativedemo://auth
# Web fallback used by the Expo Web preview (dev only)
WEB_REDIRECT_URIS=http://localhost:8081/web-auth
# Allow Expo Go's exp:// redirect during mobile testing. Prefer a development build for production.
ALLOW_EXPO_GO_REDIRECTS=false

# Local demo login. Keep false in production.
ALLOW_DEMO_AUTH=true

# Cookies are kept for the web fallback; mobile uses Bearer tokens.
SESSION_DAYS=30
COOKIE_SECURE=false
